rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function canAccess(userId) {
      return isSignedIn() && (request.auth.uid == userId || userId == 'casamento' || userId == 'shared_casamento');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidConfig(config) {
      return config is map &&
        config.goal is number &&
        config.initial is number &&
        config.start is string &&
        config.wedding is string &&
        config.rate1 is number &&
        config.rate2 is number &&
        config.yellowPct is number &&
        config.guests is number;
    }

    function isValidWedding(data) {
      return data.keys().hasAll(['userId', 'config', 'entries', 'budgets']) &&
        isValidConfig(data.config) &&
        data.entries is map &&
        data.budgets is list &&
        data.budgets.size() <= 500;
    }

    // Collection: /weddings/{userId}
    match /weddings/{userId} {
      allow get, list, delete: if canAccess(userId) && isValidId(userId);
      allow create, update: if canAccess(userId) && isValidId(userId) && isValidWedding(incoming());
    }
  }
}
